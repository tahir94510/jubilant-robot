<?xml version="1.0" encoding="utf-8"?>
<!-- Branded launch screen (pre-Android-12 path): the brand gradient with
     the logo centered. Android 12+ ignores this and uses the v31 splash
     attributes instead. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#FF1C2541"
                android:endColor="#FF3D5A80" />
        </shape>
    </item>
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_icon" />
    </item>
</layer-list>
