<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light "paper" brand field: the adaptive launcher icon sits on the warm
         cream background that matches the icon artwork (dark-ink serif + gold). -->
    <color name="ic_launcher_background">#F7F4EC</color>
    <!-- Matches AppThemes.light surface so the window behind the first
         Flutter frame never flashes a foreign color. -->
    <color name="app_surface">#F7F4EC</color>
    <!-- Splash FIELD in LIGHT mode: the light "paper" cream. The splash badge
         (@drawable/splash_icon) is now BOXLESS (transparent, dark-ink "Q"), so
         it sits directly on this cream field with no tile/border. Dark mode
         overrides this to the dark surface (values-night) + a light-Q night
         badge, so the splash is theme-adaptive and never shows a cream box. -->
    <color name="splash_background">#F7F4EC</color>
</resources>
