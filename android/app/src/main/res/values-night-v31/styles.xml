<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ system splash, dark mode. The animated icon (@drawable/
     splash_icon) is a SELF-CONTAINED badge — the dark-ink Q on its own baked
     cream tile, which the system masks to a clean disc — so a dark splash field
     can never bury the logo. In system dark mode the field is the dark brand
     surface (matching the app's dark theme); light/sepia use the cream field
     (values-v31/styles.xml). The app then paints the user's selected theme. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">#161512</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/app_surface</item>
    </style>
</resources>
