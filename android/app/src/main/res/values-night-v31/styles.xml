<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ system splash, dark mode: the brand is now a LIGHT "paper"
     identity with a dark-ink logo, so the splash stays light in dark mode too —
     a dark background here buried the dark Q ("sunk into black"). One
     consistent, high-contrast brand splash in every mode; the app then paints
     the user's selected theme. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">#F7F4EC</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/app_surface</item>
    </style>
</resources>
