<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ system splash, dark mode. The splash field is the light
     "paper" cream (@color/splash_background) in EVERY mode, matching the
     self-contained cream badge tile so the badge merges into the field (just
     the dark-ink serif "Q" on paper). windowBackground (post-splash) keeps the
     dark app surface so the handoff to a dark-themed app does not flash. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/app_surface</item>
    </style>
</resources>
