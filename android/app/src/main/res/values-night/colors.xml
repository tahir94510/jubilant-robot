<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Post-splash window background in dark mode (NormalTheme): matches
         AppThemes.dark surface so the native-splash -> first-Flutter-frame
         handoff never flashes. -->
    <color name="app_surface">#161512</color>
    <!-- Splash FIELD in dark mode: the app's dark surface. The splash badge is
         now BOXLESS + theme-adaptive (transparent; drawable-night/splash_icon
         is a LIGHT "paper" Q), so on this dark field the Q reads cleanly with
         NO cream box. Light mode keeps the cream field (values/colors.xml) with
         the dark-ink Q. Matches app_surface for a seamless splash -> app handoff. -->
    <color name="splash_background">#161512</color>
</resources>
