<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Night-mode launch field + pre-first-frame window background. The splash
         badge (@drawable/splash_icon) is SELF-CONTAINED: the dark-ink Q sits on
         its own baked cream tile, so a dark field here can never bury the logo
         (the very thing that forced cream-everywhere before). So in system dark
         mode the launch field is the dark brand surface — matching the app's
         dark theme — while light/sepia keep the cream field (values/colors.xml).
         Matches AppThemes.dark surface so the splash -> first-frame handoff in
         dark mode never flashes a foreign color. -->
    <color name="app_surface">#161512</color>
</resources>
