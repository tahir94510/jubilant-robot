<?xml version="1.0" encoding="utf-8"?>
<!-- Branded launch screen (the live path on minSdk 24+): a FLAT brand-cream
     field with the logo centered. Solid (not a gradient) and identical to the
     base drawable, so the splash never depends on the platform's day/night
     background and shows no seam. Android 12+ ignores this and uses the v31
     splash attributes instead. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/app_surface" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_icon" />
    </item>
</layer-list>
