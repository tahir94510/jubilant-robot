<?xml version="1.0" encoding="utf-8"?>
<!-- Branded launch screen (the live path on minSdk 24+): a FLAT brand field
     with the BOXLESS logo centered. Identical to the base drawable; because
     @color/splash_background and @drawable/splash_icon both carry night
     variants, it resolves to a cream field + dark-ink Q in light mode and a
     dark field + light Q in dark mode — theme-adaptive, never a cream box.
     Solid (not a gradient) so it shows no seam. Android 12+ ignores this and
     uses the v31 splash attributes instead. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_icon" />
    </item>
</layer-list>
