<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ system splash: brand background + masked logo. The
     windowBackground stays as a fallback for the brief moment after the
     system splash and before Flutter's first frame. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">#1C2541</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/app_surface</item>
    </style>
</resources>
