[
  {
    "id": "tr-001",
    "text": "Damlaya damlaya göl olur.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-002",
    "text": "Sakla samanı, gelir zamanı.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-003",
    "text": "Bugünün işini yarına bırakma.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-004",
    "text": "Akıllı düşman akılsız dosttan hayırlıdır.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-005",
    "text": "Bir elin nesi var, iki elin sesi var.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-006",
    "text": "Ayağını yorganına göre uzat.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-007",
    "text": "Tatlı dil yılanı deliğinden çıkarır.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-008",
    "text": "İnsan ne ekerse onu biçer.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-009",
    "text": "Komşu komşunun külüne muhtaçtır.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-010",
    "text": "İşleyen demir pas tutmaz.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-011",
    "text": "Aç tavuk kendini buğday ambarında sanır.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-012",
    "text": "Sabrın sonu selamettir.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-013",
    "text": "Gülü seven dikenine katlanır.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-014",
    "text": "Dost kara günde belli olur.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-015",
    "text": "Bilmemek ayıp değil, öğrenmemek ayıptır.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-016",
    "text": "Görünen köy kılavuz istemez.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-017",
    "text": "Denize düşen yılana sarılır.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-018",
    "text": "Acele işe şeytan karışır.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-019",
    "text": "Bir musibet bin nasihatten iyidir.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-020",
    "text": "Emek olmadan yemek olmaz.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-021",
    "text": "Sütten ağzı yanan yoğurdu üfleyerek yer.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-022",
    "text": "Taşıma su ile değirmen dönmez.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-023",
    "text": "Üzüm üzüme baka baka kararır.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-024",
    "text": "Yuvarlanan taş yosun tutmaz.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-025",
    "text": "Zararın neresinden dönülse kardır.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-026",
    "text": "Korkak bezirgan ne kar eder ne ziyan.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-027",
    "text": "Son pişmanlık fayda etmez, vakit geçmeden çalış.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-028",
    "text": "Hayatta en hakiki mürşit ilimdir.",
    "author": "Mustafa Kemal Atatürk",
    "source": "Söylev",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-029",
    "text": "Yurtta sulh, cihanda sulh.",
    "author": "Mustafa Kemal Atatürk",
    "source": "Atfedilen",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-030",
    "text": "Ya olduğun gibi görün ya göründüğün gibi ol.",
    "author": "Mevlana Celaleddin Rumi",
    "source": "Atfedilen",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-031",
    "text": "Sevelim sevilelim, dünya kimseye kalmaz.",
    "author": "Yunus Emre",
    "source": "Divan",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-032",
    "text": "Eline, diline, beline sahip ol.",
    "author": "Hacı Bektaş Veli",
    "source": "Atfedilen",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-033",
    "text": "Bin bilsen de bir bilene danış.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-034",
    "text": "Lafla peynir gemisi yürümez.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-035",
    "text": "Sora sora Bağdat bulunur.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-036",
    "text": "Yalancının mumu yatsıya kadar yanar.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-037",
    "text": "Misafir umduğunu değil, bulduğunu yer.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-038",
    "text": "İğneyi kendine, çuvaldızı başkasına batır.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-039",
    "text": "Ucuz etin yahnisi tatsız olur.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-040",
    "text": "Çok söyleme arsız olur, aç koyma hırsız olur.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-041",
    "text": "Horoz ne kadar öterse ötsün, sabah yine olur.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-042",
    "text": "Tembele iş buyur, sana akıl öğretsin.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-043",
    "text": "Gümüş kılıcın altın kını olmaz.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-044",
    "text": "Ağaç yaprağıyla gürler.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-101",
    "text": "Bir fincan kahvenin kırk yıl hatırı vardır.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-102",
    "text": "Sakınan göze çöp batar derler.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-103",
    "text": "Ak akçe kara gün içindir.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-104",
    "text": "Bal tutan parmağını yalar.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-105",
    "text": "Sürüden ayrılan koyunu kurt kapar, birlikten kuvvet doğar.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-106",
    "text": "Çürük tahta çivi tutmaz.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-107",
    "text": "Bakarsan bağ, bakmazsan dağ olur.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-108",
    "text": "Boş çuval ayakta durmaz.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-109",
    "text": "Rüzgar eken fırtına biçer.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-110",
    "text": "Üzümünü ye de bağını sorma.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-111",
    "text": "Görmemişin oğlu olmuş, çağırmadık yer bırakmamış.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-112",
    "text": "Keskin sirke küpüne zarar verir.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-113",
    "text": "Veren el alan elden üstündür.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-114",
    "text": "Komşunun tavuğu komşuya kaz görünür.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-115",
    "text": "Sözünü bil pişir, ağzından öyle çıkar.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-116",
    "text": "Bir çiçekle yaz gelmez, sabırla bahar açar.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-117",
    "text": "Su uyur ama düşman uyumaz, tedbirini elden bırakma.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-118",
    "text": "Atı alan Üsküdar'ı geçti.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-119",
    "text": "Damdan düşen, damdan düşenin halinden anlar.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-120",
    "text": "Mum dibine ışık vermez derler.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-121",
    "text": "Çobansız koyunu kurt kapar, başsız işin sonu gelmez.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-122",
    "text": "Ne ekersen onu biçer, ne dikersen onu giyersin.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-123",
    "text": "Doğru söyleyeni dokuz köyden kovarlar.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-124",
    "text": "İnce eleyip sık dokuyan, sonunda hayrını görür.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-125",
    "text": "Baş nereye giderse ayak da oraya gider.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-126",
    "text": "Kork Nisan'ın beşinden, öküzü ayırır eşinden.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-127",
    "text": "Gönülden gönüle yol vardır.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-128",
    "text": "Her koyun kendi bacağından asılır.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-129",
    "text": "Taş yerinde ağırdır, herkes kendi yerinde değerlidir.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-130",
    "text": "İki karpuz bir koltuğa sığmaz.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-131",
    "text": "Gözden ırak olan gönülden de ırak olur.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-132",
    "text": "Hamama giren terler, telaşa kapılan yorulur boşuna.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-133",
    "text": "Yarım hekim candan, yarım hoca dinden eder.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-134",
    "text": "Armut piş ağzıma düş diyenin işi yaş olur.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-135",
    "text": "Sabreden derviş muradına ermiş.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-136",
    "text": "Yiğit lafından, koç boynuzundan tutulur.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-137",
    "text": "Damlaya damlaya göl olur, aka aka sel olur derler.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-138",
    "text": "Bana arkadaşını söyle, sana kim olduğunu söyleyeyim.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-139",
    "text": "Hatasız kul olmaz, hatasından ders alan insan olur.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-140",
    "text": "Köprüyü geçene kadar ayıya dayı demek gerekir.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-141",
    "text": "Çıkmadık candan ümit kesilmez.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-142",
    "text": "Gülme komşuna, gelir başına.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-143",
    "text": "Aç ayı oynamaz, karnı tok olan iş görür.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-144",
    "text": "Dervişin fikri ne ise zikri de odur.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-145",
    "text": "Sakla samanı, gelir zamanı; bir gün altın değerine biner.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-146",
    "text": "Düşenin dostu olmaz, herkes ayağa kalkana el uzatır.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-147",
    "text": "Akıl yaşta değil baştadır, herkes kendi aklınca yaşar.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-148",
    "text": "İşten artmaz, dişten artar; tutumlu olan yarına kalır.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-149",
    "text": "Çok gezen mi çok bilir, çok okuyan mı çok bilir, dersin.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-150",
    "text": "Sakla başını, gözünü kaş yapma derler eski bilgeler.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-151",
    "text": "Kötü komşu insanı mal sahibi yapar, derler eskiden beri.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-152",
    "text": "Bir musibet bin nasihatten yeğdir, başına gelmeyen bilmez.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-153",
    "text": "Tok açın halinden bilmez, sağlam hastanın halinden anlamaz.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-154",
    "text": "Az tamah çok ziyan getirir, gözü doymayan elinde olanı yitirir.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-155",
    "text": "Ağaç yaşken eğilir, demir tavında dövülür, fırsat geçince bulunmaz.",
    "author": "Türk Atasözü",
    "source": "Anonim",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-156",
    "text": "Sen dünyaya gelirken ağladın, herkes güldü; öyle bir yaşa ki sen gülerken herkes ağlasın.",
    "author": "Mevlana Celaleddin Rumi",
    "source": "Atfedilen",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-157",
    "text": "Nerede olursan ol, ne olursan ol, ister kafir ister mecusi ol, yine de gel.",
    "author": "Mevlana Celaleddin Rumi",
    "source": "Atfedilen",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-158",
    "text": "İlim ilim bilmektir, ilim kendin bilmektir; sen kendini bilmezsen, bu nice okumaktır.",
    "author": "Yunus Emre",
    "source": "Divan",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-159",
    "text": "Mademki bu yolun yolcususun, gam çekme; gönlünce yürü, sevgiyle yaşa.",
    "author": "Yunus Emre",
    "source": "Divan",
    "category": "proverbs",
    "locale": "tr"
  },
  {
    "id": "tr-160",
    "text": "Korkma, sönmez bu şafaklarda yüzen al sancak; sönmeden yurdumun üstünde tüten en son ocak.",
    "author": "Mehmet Akif Ersoy",
    "source": "İstiklal Marşı",
    "category": "proverbs",
    "locale": "tr"
  }
]
