[
 {
  "id": "tr-x500",
  "text": "Bir koyundan iki post çıkmaz.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x501",
  "text": "Görünüşe aldanma, içine bak.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x502",
  "text": "Bir çürük elma bütün sepeti çürütür.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x503",
  "text": "Gözden uzak olan gönülden de uzak olur.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x504",
  "text": "Her şeyin yenisi, dostun eskisi makbuldür.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x505",
  "text": "Akıllı söyleyene değil, söyletene bakar.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x506",
  "text": "Boş torba ile at tutulmaz.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x507",
  "text": "Çürük iple kuyuya inilmez.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x508",
  "text": "Hazıra dağlar dayanmaz.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x509",
  "text": "Görünen dağa kılavuz olmaz.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x510",
  "text": "Az yiyen her zaman yer, çok yiyen bir kez yer.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x511",
  "text": "Selam verdim borç için, hızmet ettim yurt için demezler.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x512",
  "text": "Mum yanmadan ışık vermez.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x513",
  "text": "Sürçen at bir daha yola çıkmaz olmaz.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x514",
  "text": "Ekmeden biçilmez, vermeden alınmaz.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x515",
  "text": "Cefayı çekmeyen sefanın kadrini bilmez.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x516",
  "text": "Tava sıcakken demir dövülür.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x517",
  "text": "Yalan ile iman bir yerde durmaz.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x518",
  "text": "Bakarsan bağ olur, bakmazsan dağ olur.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x519",
  "text": "Bir gönül yaptım deyince bin sevap kazanırsın.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x520",
  "text": "El elden üstündür ta arşa varınca.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x521",
  "text": "Gün doğmadan neler doğar.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x522",
  "text": "Hocanın dediğini yap, yaptığını yapma.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x523",
  "text": "Kabahat samur kürk olsa kimse üstüne almaz.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x524",
  "text": "Kaz gelecek yerden tavuk esirgenmez.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x525",
  "text": "Kedi olur ciğere bakar, fare bekler köşeyi.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x526",
  "text": "Kork korkutandan, utan utandırandan.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x527",
  "text": "Köpeğe gem vurma, kendini at sanır.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x528",
  "text": "Leyleğin ömrü laklakla geçer.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x529",
  "text": "Mart yağar nisan övünür, nisan yağar insan övünür.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x530",
  "text": "Nereye gitsen okka dört yüz dirhem.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x531",
  "text": "Öküz öldü ortaklık ayrıldı.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x532",
  "text": "Para isteme benden, buz gibi soğurum senden.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x533",
  "text": "Rüzgara tüküren kendi yüzüne tükürür.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x534",
  "text": "Sürüye kurt girince kuzu kaçacak yer arar.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x535",
  "text": "Tarla almadan harman görme.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x536",
  "text": "Tok ile pişmeyen aş, sahibini yorar.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x537",
  "text": "Uyuyan yılanın kuyruğuna basma.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x538",
  "text": "Üzülme, geçer; sevin, o da geçer.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x539",
  "text": "Vermeyince Mabut, ne yapsın Mahmut.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x540",
  "text": "Yağmurdan kaçarken doluya tutuldu.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x541",
  "text": "Abanın kadrini yağmurda bilirsin.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x542",
  "text": "Acındırırsan arsız olur, acıktırırsan hırsız olur.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x543",
  "text": "Ağzından çıkanı kulağı duysun.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x544",
  "text": "Akşamın işini sabaha bırakma.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x545",
  "text": "Allah bir kapıyı kaparsa bin kapı açar.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x546",
  "text": "Aşağı tükürsen sakal, yukarı tükürsen bıyık.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x547",
  "text": "Ayının kırk türküsü var, kırkı da ahlat üstüne.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x548",
  "text": "Bağ bayırda, tarla çayırda olsun.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x549",
  "text": "Bekarlık sultanlıktır.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x550",
  "text": "Besledik büyüttük danayı, tanımaz oldu anayı.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x551",
  "text": "Bir deli kuyuya taş atar, kırk akıllı çıkaramaz.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x552",
  "text": "Bir kötünün yedi mahalleye zararı vardır.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x553",
  "text": "Buğdayım var deme ambara girmeyince.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x554",
  "text": "Buyana çok söylersen değerini kaybeder.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x555",
  "text": "Cahil dostan akıllı düşman yeğdir.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x556",
  "text": "Çağrılan yere erinme, çağrılmayan yeri görünme.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x557",
  "text": "Damlardan dökülen, oluğa akar.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x558",
  "text": "Deli ile çıkma yola, başına gelir bin türlü bela.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x559",
  "text": "Denize girmeden ıslanmaz.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x560",
  "text": "Doğru söyleyenin tepesi delik olur.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x561",
  "text": "Dost ile ye, iç; alışveriş etme.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x562",
  "text": "Düşmez kalkmaz bir Allah.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x563",
  "text": "Eğreti ata binen tez iner.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x564",
  "text": "Ekşi koğa ekşi maya olur.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x565",
  "text": "Eldeki yara, yarasıza duvar deliği.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x566",
  "text": "Er olan ekmeğini taştan çıkarır.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x567",
  "text": "Eşeğe altın semer vursalar yine eşektir.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x568",
  "text": "Evdeki hesap çarşıya uymaz.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x569",
  "text": "Gavurun ekmeğini yiyen gavurun kılıcını sallar.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x570",
  "text": "Gençlikte taş taşı, kocalıkta ye aşı.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x571",
  "text": "Gönül bir sırça saraydır, kırılırsa yapılmaz.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x572",
  "text": "Gözü tanede olan kuşun ayağı tuzaktan kurtulmaz.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x573",
  "text": "Güzele bakmak sevaptır.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x574",
  "text": "Hamama giren terlemekten kurtulmaz.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x575",
  "text": "Hekimden sorma, çekenden sor.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x576",
  "text": "Irmak kenarına çeşme yapılmaz.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x577",
  "text": "İğneyi kendine batır, çuvaldızı ele.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x578",
  "text": "İki at bir kazığa bağlanmaz.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x579",
  "text": "İnsan yedisinde ne ise yetmişinde de odur.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x580",
  "text": "İşin yoksa şahit ol, paran çoksa kefil ol.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x581",
  "text": "İyi insan lafının üstüne gelir.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x582",
  "text": "Kar ne kadar çok yağsa yaza kalmaz.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x583",
  "text": "Kaz kazla, daz dazla; kel tavuk kel horozla.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x584",
  "text": "Keçi can derdinde, kasap yağ derdinde.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x585",
  "text": "Kızını dövmeyen dizini döver.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x586",
  "text": "Köpeğin duası kabul olsa gökten kemik yağar.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x587",
  "text": "Kurt kocayınca köpeğin maskarası olur.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x588",
  "text": "Misafir kısmetiyle gelir.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x589",
  "text": "Nasıl yaşarsan öyle ölürsün.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x590",
  "text": "Ne yavuz ol asıl, ne yavaş ol basıl.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x591",
  "text": "Ölme eşeğim ölme, yonca bitecek.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x592",
  "text": "Para ile imanın kimde olduğu bilinmez.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x593",
  "text": "Rüzgar esmeyince dal oynamaz.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x594",
  "text": "Saymadan kazanan, saymadan harcar.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x595",
  "text": "Sinek küçüktür ama mide bulandırır.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x596",
  "text": "Tatlı söz yılanı deliğinden çıkarır.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x597",
  "text": "Tok ağırlamak kolaydır, açı doyurmak güçtür.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x598",
  "text": "Ummadığın taş baş yarar.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x599",
  "text": "Üşenenin oğlu kızı olmaz.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x600",
  "text": "Var evi kerem evi, yok evi verem evi.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x601",
  "text": "Yağ ile bal yedik, sonu kara oldu.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x602",
  "text": "Yiğit yarasına yiğit katlanır.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x603",
  "text": "Zengin arabasını dağdan aşırır, fakir düz yolda şaşırır.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x604",
  "text": "Adam ahbabından bellidir.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 },
 {
  "id": "tr-x605",
  "text": "Bir ağızdan çıkan bin ağıza yayılır.",
  "author": "Türk Atasözü",
  "source": "Anonim",
  "category": "proverbs",
  "locale": "tr"
 }
]