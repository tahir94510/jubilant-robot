[
  { "id": "tr-001", "text": "Damlaya damlaya göl olur.", "author": "Türk Atasözü", "source": "Anonim", "category": "turkish", "locale": "tr" },
  { "id": "tr-002", "text": "Sakla samanı, gelir zamanı.", "author": "Türk Atasözü", "source": "Anonim", "category": "turkish", "locale": "tr" },
  { "id": "tr-003", "text": "Bugünün işini yarına bırakma.", "author": "Türk Atasözü", "source": "Anonim", "category": "turkish", "locale": "tr" },
  { "id": "tr-004", "text": "Akıllı düşman akılsız dosttan hayırlıdır.", "author": "Türk Atasözü", "source": "Anonim", "category": "turkish", "locale": "tr" },
  { "id": "tr-005", "text": "Bir elin nesi var, iki elin sesi var.", "author": "Türk Atasözü", "source": "Anonim", "category": "turkish", "locale": "tr" },
  { "id": "tr-006", "text": "Ayağını yorganına göre uzat.", "author": "Türk Atasözü", "source": "Anonim", "category": "turkish", "locale": "tr" },
  { "id": "tr-007", "text": "Tatlı dil yılanı deliğinden çıkarır.", "author": "Türk Atasözü", "source": "Anonim", "category": "turkish", "locale": "tr" },
  { "id": "tr-008", "text": "İnsan ne ekerse onu biçer.", "author": "Türk Atasözü", "source": "Anonim", "category": "turkish", "locale": "tr" },
  { "id": "tr-009", "text": "Komşu komşunun külüne muhtaçtır.", "author": "Türk Atasözü", "source": "Anonim", "category": "turkish", "locale": "tr" },
  { "id": "tr-010", "text": "İşleyen demir pas tutmaz.", "author": "Türk Atasözü", "source": "Anonim", "category": "turkish", "locale": "tr" },
  { "id": "tr-011", "text": "Aç tavuk kendini buğday ambarında sanır.", "author": "Türk Atasözü", "source": "Anonim", "category": "turkish", "locale": "tr" },
  { "id": "tr-012", "text": "Sabrın sonu selamettir.", "author": "Türk Atasözü", "source": "Anonim", "category": "turkish", "locale": "tr" },
  { "id": "tr-013", "text": "Gülü seven dikenine katlanır.", "author": "Türk Atasözü", "source": "Anonim", "category": "turkish", "locale": "tr" },
  { "id": "tr-014", "text": "Dost kara günde belli olur.", "author": "Türk Atasözü", "source": "Anonim", "category": "turkish", "locale": "tr" },
  { "id": "tr-015", "text": "Bilmemek ayıp değil, öğrenmemek ayıptır.", "author": "Türk Atasözü", "source": "Anonim", "category": "turkish", "locale": "tr" },
  { "id": "tr-016", "text": "Görünen köy kılavuz istemez.", "author": "Türk Atasözü", "source": "Anonim", "category": "turkish", "locale": "tr" },
  { "id": "tr-017", "text": "Denize düşen yılana sarılır.", "author": "Türk Atasözü", "source": "Anonim", "category": "turkish", "locale": "tr" },
  { "id": "tr-018", "text": "Acele işe şeytan karışır.", "author": "Türk Atasözü", "source": "Anonim", "category": "turkish", "locale": "tr" },
  { "id": "tr-019", "text": "Bir musibet bin nasihatten iyidir.", "author": "Türk Atasözü", "source": "Anonim", "category": "turkish", "locale": "tr" },
  { "id": "tr-020", "text": "Emek olmadan yemek olmaz.", "author": "Türk Atasözü", "source": "Anonim", "category": "turkish", "locale": "tr" },
  { "id": "tr-021", "text": "Sütten ağzı yanan yoğurdu üfleyerek yer.", "author": "Türk Atasözü", "source": "Anonim", "category": "turkish", "locale": "tr" },
  { "id": "tr-022", "text": "Taşıma su ile değirmen dönmez.", "author": "Türk Atasözü", "source": "Anonim", "category": "turkish", "locale": "tr" },
  { "id": "tr-023", "text": "Üzüm üzüme baka baka kararır.", "author": "Türk Atasözü", "source": "Anonim", "category": "turkish", "locale": "tr" },
  { "id": "tr-024", "text": "Yuvarlanan taş yosun tutmaz.", "author": "Türk Atasözü", "source": "Anonim", "category": "turkish", "locale": "tr" },
  { "id": "tr-025", "text": "Zararın neresinden dönülse kardır.", "author": "Türk Atasözü", "source": "Anonim", "category": "turkish", "locale": "tr" },
  { "id": "tr-026", "text": "Korkak bezirgan ne kar eder ne ziyan.", "author": "Türk Atasözü", "source": "Anonim", "category": "turkish", "locale": "tr" },
  { "id": "tr-027", "text": "Son pişmanlık fayda etmez, vakit geçmeden çalış.", "author": "Türk Atasözü", "source": "Anonim", "category": "turkish", "locale": "tr" },
  { "id": "tr-028", "text": "Hayatta en hakiki mürşit ilimdir.", "author": "Mustafa Kemal Atatürk", "source": "Söylev", "category": "turkish", "locale": "tr" },
  { "id": "tr-029", "text": "Yurtta sulh, cihanda sulh.", "author": "Mustafa Kemal Atatürk", "source": "Atfedilen", "category": "turkish", "locale": "tr" },
  { "id": "tr-030", "text": "Ya olduğun gibi görün ya göründüğün gibi ol.", "author": "Mevlana Celaleddin Rumi", "source": "Atfedilen", "category": "turkish", "locale": "tr" },
  { "id": "tr-031", "text": "Sevelim sevilelim, dünya kimseye kalmaz.", "author": "Yunus Emre", "source": "Divan", "category": "turkish", "locale": "tr" },
  { "id": "tr-032", "text": "Eline, diline, beline sahip ol.", "author": "Hacı Bektaş Veli", "source": "Atfedilen", "category": "turkish", "locale": "tr" }
]
