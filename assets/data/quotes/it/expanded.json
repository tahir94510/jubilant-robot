[
  {
    "id": "it-x002",
    "text": "L'amor che move il sole e l'altre stelle.",
    "author": "Dante Alighieri",
    "source": "Divina Commedia",
    "category": "classics",
    "locale": "it"
  },
  {
    "id": "it-x003",
    "text": "Il fine giustifica i mezzi.",
    "author": "Niccolò Machiavelli",
    "source": "Il Principe",
    "category": "classics",
    "locale": "it"
  },
  {
    "id": "it-x004",
    "text": "La semplicità è la massima sofisticazione.",
    "author": "Leonardo da Vinci",
    "source": "Codici",
    "category": "wisdom",
    "locale": "it"
  },
  {
    "id": "it-x006",
    "text": "Il naufragar m'è dolce in questo mare.",
    "author": "Giacomo Leopardi",
    "source": "L'infinito",
    "category": "literature",
    "locale": "it"
  },
  {
    "id": "it-x007",
    "text": "Ai posteri l'ardua sentenza.",
    "author": "Alessandro Manzoni",
    "source": "Il cinque maggio",
    "category": "literature",
    "locale": "it"
  },
  {
    "id": "it-x012",
    "text": "Non è tutto oro quel che luccica.",
    "author": "Proverbio italiano",
    "source": "Anonimo",
    "category": "proverbs",
    "locale": "it"
  },
  {
    "id": "it-x015",
    "text": "Can che abbaia non morde.",
    "author": "Proverbio italiano",
    "source": "Anonimo",
    "category": "proverbs",
    "locale": "it"
  },
  {
    "id": "it-x202",
    "text": "La gloria di colui che tutto move per l'universo penetra e risplende.",
    "author": "Dante Alighieri",
    "source": "Divina Commedia",
    "category": "classics",
    "locale": "it"
  },
  {
    "id": "it-x207",
    "text": "L'ozio è il padre dei vizi.",
    "author": "Proverbio italiano",
    "source": "Anonimo",
    "category": "proverbs",
    "locale": "it"
  },
  {
    "id": "it-x211",
    "text": "A buon intenditor poche parole.",
    "author": "Proverbio italiano",
    "source": "Anonimo",
    "category": "proverbs",
    "locale": "it"
  },
  {
    "id": "it-x300",
    "text": "La vita è come uno specchio: ti sorride se la guardi sorridendo.",
    "author": "Proverbio italiano",
    "source": "Anonimo",
    "category": "proverbs",
    "locale": "it"
  },
  {
    "id": "it-x301",
    "text": "Anche il viaggio più lungo comincia con un solo passo.",
    "author": "Lao Tzu",
    "source": "Tao Te Ching",
    "category": "wisdom",
    "locale": "it"
  },
  {
    "id": "it-x303",
    "text": "Volli, e volli sempre, e fortissimamente volli.",
    "author": "Vittorio Alfieri",
    "source": "Lettere",
    "category": "classics",
    "locale": "it"
  },
  {
    "id": "it-x304",
    "text": "Sempre caro mi fu quest'ermo colle.",
    "author": "Giacomo Leopardi",
    "source": "L'infinito",
    "category": "literature",
    "locale": "it"
  },
  {
    "id": "it-x305",
    "text": "La speranza è l'ultima a morire.",
    "author": "Proverbio italiano",
    "source": "Anonimo",
    "category": "proverbs",
    "locale": "it"
  },
  {
    "id": "it-x310",
    "text": "Fidarsi è bene, non fidarsi è meglio.",
    "author": "Proverbio italiano",
    "source": "Anonimo",
    "category": "proverbs",
    "locale": "it"
  },
  {
    "id": "it-x312",
    "text": "Ride bene chi ride ultimo.",
    "author": "Proverbio italiano",
    "source": "Anonimo",
    "category": "proverbs",
    "locale": "it"
  }
]
